{
  "name": "arsi",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.x"
  },
  "bin": {
    "arsi": "./dist/src/entries/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./contracts": {
      "types": "./dist/src/contracts/index.d.ts",
      "import": "./dist/src/contracts/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "pnpm-lock.yaml"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "arsi": "node dist/src/entries/cli/main.js",
    "typecheck": "tsc --noEmit",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "test": "node --import tsx --test tests/unit/*.test.ts tests/unit/*.test.mjs",
    "format": "prettier --write src examples web tests scripts .github/review .github/workflows/ci.yml .github/PULL_REQUEST_TEMPLATE.md eslint.config.mjs package.json tsconfig*.json pnpm-workspace.yaml",
    "format:check": "prettier --check src examples web tests scripts .github/review .github/workflows/ci.yml .github/PULL_REQUEST_TEMPLATE.md eslint.config.mjs package.json tsconfig*.json pnpm-workspace.yaml",
    "lint": "eslint src web",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "review:worker": "node .github/review/cli.mjs worker",
    "review:local": "node .github/review/cli.mjs local",
    "check": "pnpm format:check && pnpm lint && pnpm check:architecture && pnpm check:docs && pnpm typecheck && pnpm typecheck:web && pnpm test && pnpm build",
    "check:package": "node scripts/check-package.mjs",
    "build:web": "vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "prepare": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "1.9.0",
    "@deepseek-ai/cordis": "4.0.2",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@fastify/static": "10.1.7",
    "@logtape/logtape": "2.4.2",
    "agent-bundle-core": "git+https://github.com/ARSI-LAB/agentbundle.git#0.0.2&path:/packages/core",
    "ajv": "8.20.0",
    "arsi-evaluator": "git+https://github.com/ARSI-LAB/ARSI-Evaluator.git#0.0.6",
    "boxen": "9.0.0",
    "commander": "15.0.0",
    "exceljs": "4.4.0",
    "fastify": "5.12.7",
    "htmlparser2": "10.0.0",
    "mammoth": "1.11.0",
    "node-diff3": "3.2.1",
    "ora": "9.4.1",
    "pdfjs-dist": "5.4.449",
    "picocolors": "1.1.1",
    "proper-lockfile": "4.1.2",
    "string-width": "8.3.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.10.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cn": "0.5.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "3.6.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "3.8.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.4"
  },
  "bundleDependencies": [
    "arsi-evaluator",
    "agent-bundle-core"
  ]
}
